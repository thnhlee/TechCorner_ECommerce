@model IEnumerable<TechCorner_ECommerce.ViewModels.MenuSubCategoryVM>

@{
    Layout = "_LayoutDashboard";
}
<main class="content py-4">
    <div class="container-fluid py-4">
        <h2 class="mb-4" ></h2>
                <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="mb-1">Sub-Categories</h2>
                <p class="text-muted mb-0">
                    Manage product sub-categories
                </p>
            </div>

            <div>
                <a asp-action="Create"
                   class="btn btn-primary">
                    Add SubCategory
                </a>

                <a asp-controller="Category" asp-action="Index"
                    class="btn btn-light border">
                    Back
                </a>
            </div>


        </div>

        <!-- FILTER -->
        <form method="get" class="row mb-3">

            <div class="col-md-3">
                <select name="categoryId" class="form-select">
                    <option value="">All Category</option>
                    @foreach (var c in ViewBag.Categories)
                    {
                        <option value="@c.CategoryId">@c.Name</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search SubCategory..." />
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary">Filter</button>
            </div>

        </form>

        <!-- TABLE -->
        <div class="card table-responsive">

            <table class="table table-hover mb-0">

                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>SubCategory</th>
                        <th>Products</th>
                        <th>Category</th>
                        
                        @* <th>Created</th> *@
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>
                            <td>@item.Name</td>
                            <td>
                                <span class="badge bg-primary" style="margin-left: 15px">
                                    @item.Quantity
                                </span>
                            </td>
                            <td>@item.CategoryName</td>
                            
                            @* <td>@item.CreatedAt.ToString("dd/MM/yyyy")</td> *@

                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="text-warning fs-5">
                                        <i class="ti ti-edit"></i>
                                    </a>

                                    <button class="btn p-0 border-0 bg-transparent link-danger" onclick="openDelete(@item.Id, '@item.Name', @item.Quantity)">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

    <!-- DELETE MODAL -->
    <div class="modal fade" id="deleteModal">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5>Delete SubCategory</h5>
                </div>

                <div class="modal-body">

                    <div id="deleteError"
                         class="alert alert-danger d-none mb-3">
                    </div>

                    Are you sure delete
                    <strong id="subName"></strong> ?

                </div>

                <div class="modal-footer">

                    <button class="btn btn-danger" id="confirmDelete">
                        Delete
                    </button>

                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                </div>

            </div>
        </div>
    </div>

</main>
<script>

    let deleteId = 0;
    let canDelete = true;

    function openDelete(id, name, productCount) {

        deleteId = id;

        document.getElementById("subName").innerText = name;

        const errorBox =
            document.getElementById("deleteError");

        errorBox.classList.add("d-none");
        errorBox.innerText = "";

        if (productCount > 0) {

            canDelete = false;

            errorBox.innerText =
                "Cannot delete because it has products";

            errorBox.classList.remove("d-none");

        } else {

            canDelete = true;
        }

        new bootstrap.Modal(
            document.getElementById("deleteModal")
        ).show();
    }

    document.getElementById("confirmDelete")
        .addEventListener("click", function () {

        if (!canDelete) return;

        const formData = new FormData();

        formData.append("id", deleteId);

        fetch('/Admin/SubCategory/Delete', {

            method: 'POST',

            body: formData

        })
        .then(r => r.json())
        .then(res => {

            if (res.success) {

                location.reload();

            } else {

                const errorBox =
                    document.getElementById("deleteError");

                errorBox.innerText = res.message;

                errorBox.classList.remove("d-none");
            }
        });

    });

</script>