@model TechCorner_ECommerce.ViewModels.SubCategoryCreateVM

@{
    Layout = "_LayoutDashboard";
}

<main class="content py-4">

    <div class="container-fluid">

        <h2 class="mb-4">Add SubCategory</h2>

        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="mb-1">Create SubCategory</h2>

                <p class="text-muted mb-0">
                    Add a new subcategory
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-light border">
                Back
            </a>

        </div>

        <div asp-validation-summary="All"
             class="text-danger mb-3"></div>

        <div class="card">

            <div class="card-header">
                <strong>SubCategory Form</strong>
            </div>

            <div class="card-body">

                <form method="post">

                    <!-- CATEGORY -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Category
                        </label>

                        <select asp-for="CategoryId"
                                class="form-select">

                            <option value="">
                                Select category
                            </option>

                            @foreach (var c in Model.Categories)
                            {
                                <option value="@c.Id">
                                    @c.Name
                                </option>
                            }

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger"></span>

                    </div>

                    <!-- NAME -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            SubCategory Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter subcategory name" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>

                    </div>

                    <!-- BUTTON -->
                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-success">

                            Create SubCategory

                        </button>

                        <a asp-action="Index"
                           class="btn btn-light border">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</main>

<partial name="_ValidationScriptsPartial" />