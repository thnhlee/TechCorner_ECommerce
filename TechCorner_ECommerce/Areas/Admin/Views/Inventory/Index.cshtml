@model X.PagedList.IPagedList<TechCorner_ECommerce.ViewModels.ProductVM>
@using X.PagedList.Mvc.Core;

@{
    Layout = "_LayoutDashboard";
}
<!-- MAIN CONTENT -->
<main id="content" class="content py-10">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="">
                        <h1 class="fs-3 mb-1">Inventory</h1>
                        <p class="mb-0">Manage your product inventory</p>
                    </div>
                    <div>
                        <a asp-area="Admin" asp-controller="Product" asp-action="AddProduct" class="btn btn-primary">Add Product</a>
                    </div>
                </div>

                <form method="get" class="row mb-3">
                    <div class="col-md-3">
                        <select name="cate" class="form-select">
                            <option value="">All SubCategories</option>
                            @foreach (var s in ViewBag.SubCategories)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <input name="keyword" value="@ViewBag.SearchQuery" type="text" class="form-control" placeholder="Search products..." style="max-width: 250px;">
                    </div>

                    <div class="col-md-2">
                        <button class="btn btn-primary">Filter</button>
                    </div>
                    <div class="col-md-auto ms-auto text-end">
                        <button asp-controller="Inventory" asp-action="ExportToExcel" class="btn btn-outline-secondary">
                            <i class="ti ti-file-excel"></i> Excel
                        </button>
                        <button class="btn btn-outline-secondary">
                            <i class="ti ti-file-pdf"></i> PDF
                        </button>
                    </div> 
                </form> 


            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div>
                    <div class="d-flex gap-2 mb-3 flex-wrap justify-content-between">


                        
                    </div>
                </div>

                <div class="card table-responsive ">
                    <table class="table mb-0 text-nowrap table-hover">

                        <thead class="table-light border-light">
                            <tr>
                                <th class="fw-bold">Id</th>
                                <th class="fw-bold">Product</th>
                                <th class="fw-bold">Attributes</th>

                                
                                <th class="fw-bold">Category</th>
                                <th class="fw-bold">SubCategory</th>
                                <th class="fw-bold">Price</th>
                                <th class="fw-bold">Quantity</th>
                                <th class="fw-bold">Action</th>
                            </tr>
                        </thead>

                        @foreach (var item in Model) {
                            <tbody>
                                <tr class="align-middle ">
                                    <td>#@item.SkuCode</td>
                                    <td>
                                        <a href=""><img src="@item.ImageUrl" alt="" class="avatar avatar-md rounded" /><span class="ms-3">@item.Name</span></a>
                                    </td>
                                    <td>

                                        <span class="badge bg-light text-dark border px-2 py-1" style="margin-left: 12px">

                                            @string.Join(" / ", item.Attributes.Select(x => x.Value))

                                        </span>

                                    </td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.SubCategoryName</td>
                                    <td>$@item.Price</td>
                                    <td>
                                        <span class="badge bg-primary " style="margin-left: 15px">
                                            @item.Stock
                                        </span>
                                    </td>
                                    <td class="">
    
                                        <div class="d-flex align-items-center gap-2">

                                            <a asp-controller="Product"
                                               asp-action="EditProduct"
                                               asp-route-id="@item.PublicId"
                                               class="text-warning fs-5 d-flex align-items-center">

                                                <i class="ti ti-edit"></i>

                                            </a>

                                            <button type="button"
                                                    class="btn p-0 border-0 bg-transparent link-danger d-flex align-items-center"
                                                    onclick="openDeleteModal(@item.Id, '@item.Name')">

                                                <i class="ti ti-trash"></i>

                                            </button>

                                        </div>

                                    </td>
                                </tr>

                            </tbody>
                        }
                        <tfoot class="">

                            <tr>
                                
                                <td colspan="9" class="border-bottom-0">
                                    <partial name="_Paging" model="Model" />
                                </td>
                            </tr>

                        </tfoot>
                    </table>
                </div>


            </div>

        </div>
        <div class="row">
            <div class="col-12">
                <footer class="text-center py-2 mt-6 text-secondary ">
                    <p class="mb-0">Copyright © 2026 InApp Inventory Dashboard. Developed by <a href="https://codescandy.com/" target="_blank" class="text-primary">CodesCandy</a> • Distributed by <a href="https://themewagon.com/" target="_blank" class="text-primary">ThemeWagon</a> </p>
                </footer>
            </div>

        </div>

    </div>

    <!-- DELETE MODAL -->
    <div class="modal fade" id="deleteModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5>Delete Variant</h5>

                </div>

                <div class="modal-body">

                    Are you sure delete
                    <strong id="productName"></strong> ?

                </div>

                <div class="modal-footer">

                    <button class="btn btn-danger" id="confirmDelete">
                        Delete
                    </button>

                    <button class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                </div>

            </div>

        </div>

    </div>
</main>


<script>

    let deleteId = 0;

    function openDeleteModal(id, name) {

        deleteId = id;

        document.getElementById("productName").innerText = name;

        let modal = new bootstrap.Modal(
            document.getElementById("deleteModal")
        );

        modal.show();
    }

    document.getElementById("confirmDelete")
        .addEventListener("click", function () {

        const formData = new FormData();

        formData.append("id", deleteId);

        fetch('/Admin/Product/DeleteVariant', {

            method: 'POST',

            body: formData

        })
        .then(r => r.json())
        .then(res => {

            if (res.success) {

                location.reload();

            } else {

                alert(res.message);
            }
        });

    });

</script>