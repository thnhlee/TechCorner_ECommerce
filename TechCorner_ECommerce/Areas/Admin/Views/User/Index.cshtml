@model X.PagedList.IPagedList<TechCorner_ECommerce.ViewModels.UserListVM>
@using X.PagedList.Mvc.Core

@{
    Layout = "_LayoutDashboard";
}

<main class="content py-4">
    <div class="container-fluid">

        <h2 class="mb-4" >User accounts</h2>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fs-3 mb-1">Users</h1>
                <p class="mb-0">Manage user accounts</p>
            </div>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form method="get" class="row mb-3">

            <div class="col-md-3">
                <input name="keyword"
                       value="@ViewBag.SearchQuery"
                       type="text"
                       class="form-control"
                       placeholder="Search users..." />
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary">
                    Filter
                </button>
            </div>

        </form>

        <div class="card table-responsive">
            <table class="table mb-0 text-nowrap table-hover">

                <thead class="table-light border-light">
                    <tr>
                        <th class="fw-bold">No.</th>
                        <th class="fw-bold">UserName</th>
                        <th class="fw-bold">Email</th>
                        <th class="fw-bold">Phone</th>
                        <th class="fw-bold">Address</th>
                        <th class="fw-bold">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="align-middle">
                            <td>@item.No</td>
                            <td>@item.UserName</td>
                            <td>@item.Email</td>
                            <td>@item.Phone</td>
                            <td style="max-width: 300px; white-space: normal;">
                                @item.Address
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-2">

                                    <a asp-area="Admin" asp-controller="User" asp-action="Edit" asp-route-id="@item.Id"
                                       class="text-warning fs-5 d-flex align-items-center">

                                        <i class="ti ti-edit"></i>

                                    </a>

                                    <button type="button"
                                            class="btn p-0 border-0 bg-transparent link-danger d-flex align-items-center"
                                            onclick="openDeleteModal('@item.Id', '@item.UserName')">

                                        <i class="ti ti-trash"></i>

                                    </button>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <partial name="_Paging" model="Model" />

    </div>

    <!-- DELETE MODAL -->
    <div class="modal fade" id="deleteModal">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5>Delete User</h5>
                </div>

                <div class="modal-body">

                    <div id="deleteError"
                         class="alert alert-danger d-none mb-3">
                    </div>

                    Are you sure delete
                    <strong id="userName"></strong> ?

                </div>

                <div class="modal-footer">

                    <button class="btn btn-danger" id="confirmDelete">
                        Delete
                    </button>

                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                </div>

            </div>
        </div>
    </div>

</main>

<script>
    let deleteId = "";

    function openDeleteModal(id, name) {

        deleteId = id;

        document.getElementById("userName").innerText = name;

        const errorBox = document.getElementById("deleteError");
        errorBox.classList.add("d-none");
        errorBox.innerText = "";

        new bootstrap.Modal(
            document.getElementById("deleteModal")
        ).show();
    }

    document.getElementById("confirmDelete")
        .addEventListener("click", function () {

            const formData = new FormData();

            formData.append("id", deleteId);

            fetch('/Admin/User/Delete', {
                method: 'POST',
                headers: {RequestVerificationToken: getToken()},
                body: formData
            })
            .then(r => r.json())
            .then(res => {

                if (res.success) {

                    location.reload();

                } else {

                    const errorBox =
                        document.getElementById("deleteError");

                    errorBox.innerText = res.message;

                    errorBox.classList.remove("d-none");
                }
            });
        });
</script>