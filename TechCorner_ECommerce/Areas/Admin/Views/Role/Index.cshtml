@model X.PagedList.IPagedList<TechCorner_ECommerce.ViewModels.RoleVM>
@using X.PagedList.Mvc.Core

@{
    Layout = "_LayoutDashboard";
}

<main class="content py-4">
    <div class="container-fluid">
        <h2 class="mb-4">Roles</h2>
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h1 class="fs-3 mb-1">Roles</h1>
                <p class="mb-0">Manage identity roles</p>
            </div>

            <div>
                <a asp-area="Admin" asp-controller="Role" asp-action="CreateRole" class="btn btn-primary">
                    Add Role
                </a>
            
                <a asp-controller="User" asp-action="Index" class="btn btn-light border">
                    Back
                </a>
            </div>


        </div>

        @if (TempData["Error"] != null) {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form method="get" class="row mb-3">

            <div class="col-md-3">
                <input name="keyword" value="@ViewBag.SearchQuery" type="text" class="form-control" placeholder="Search roles..." />
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary">
                    Filter
                </button>
            </div>

        </form>

        <div class="card table-responsive">
            <table class="table mb-0 text-nowrap table-hover">

                <thead class="table-light border-light">
                    <tr>
                        <th class="fw-bold">No.</th>
                        <th class="fw-bold">Role Name</th>
                        <th class="fw-bold">Users</th>
                        <th class="fw-bold">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model) {
                        <tr class="align-middle">
                            <td>@item.No</td>
                            <td>@item.Name</td>
                            <td>
                                <span class="badge bg-primary">
                                    @item.UserCount
                                </span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">

                                    <a asp-area="Admin" asp-controller="Role" asp-action="EditRole" asp-route-id="@item.Id"
                                       class="text-warning fs-5 d-flex align-items-center">

                                        <i class="ti ti-edit"></i>

                                    </a>

                                    <button type="button" class="btn p-0 border-0 bg-transparent link-danger d-flex align-items-center" onclick="openDeleteModal('@item.Id', '@item.Name')">

                                        <i class="ti ti-trash"></i>

                                    </button>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <partial name="_Paging" model="Model" />

    </div>

    <!-- DELETE MODAL -->
    <div class="modal fade" id="deleteModal">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5>Delete Role</h5>
                </div>

                <div class="modal-body">

                    <div id="deleteError"
                         class="alert alert-danger d-none mb-3">
                    </div>

                    Are you sure delete
                    <strong id="roleName"></strong> ?

                </div>

                <div class="modal-footer">

                    <button class="btn btn-danger" id="confirmDelete">
                        Delete
                    </button>

                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                </div>

            </div>
        </div>
    </div>

</main>

<script>
    let deleteId = "";

    function openDeleteModal(id, name) {

        deleteId = id;

        document.getElementById("roleName").innerText = name;

        const errorBox =
            document.getElementById("deleteError");

        errorBox.classList.add("d-none");
        errorBox.innerText = "";

        new bootstrap.Modal(
            document.getElementById("deleteModal")
        ).show();
    }

    document.getElementById("confirmDelete")
        .addEventListener("click", function () {

        const formData = new FormData();

        formData.append("id", deleteId);

        fetch('/Admin/Role/Delete', {

            method: 'POST',

            headers: {
                RequestVerificationToken: getToken()
            },

            body: formData

        })
        .then(r => r.json())
        .then(res => {

            if (res.success) {

                location.reload();

            } else {

                const errorBox =
                    document.getElementById("deleteError");

                errorBox.innerText = res.message;

                errorBox.classList.remove("d-none");
            }
        });
    });
</script>