@model TechCorner_ECommerce.ViewModels.RoleCreateVM

@{
    Layout = "_LayoutDashboard";
}

<main class="content py-4">
    <div class="container-fluid">
        <h2 class="mb-4">AddRoles</h2>
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2>Add Role</h2>
                <p class="text-muted mb-0">
                    Create new identity role
                </p>
            </div>

            <a asp-area="Admin" asp-controller="Role" asp-action="Index" class="btn btn-light border">
                Back
            </a>

        </div>

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <form asp-area="Admin" asp-controller="Role" asp-action="CreateRole" method="post">

            @Html.AntiForgeryToken()

            <div class="card mb-4">

                <div class="card-header">
                    <strong>Role Information</strong>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Role Name
                        </label>

                        <input asp-for="Name" class="form-control" placeholder="Example: Admin, Customer, Staff" />

                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                </div>

            </div>

            <button class="btn btn-success">
                Save Role
            </button>

        </form>

    </div>
</main>

<partial name="_ValidationScriptsPartial" />