@model TechCorner_ECommerce.ViewModels.CreateProductVM
@{
    Layout = "_LayoutDashboard";
}

<main class="content py-10">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="d-flex flex-md-row justify-content-between align-items-md-center mb-4">
                    <div>
                        <h1 class="fs-3 mb-1 fw-bold">Add Product</h1>
                        <p class="text-muted mb-0">Manage your inventory items</p>
                    </div>

                    <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" class="btn btn-primary">
                        Go to Inventory List
                    </a>
                </div>
            </div>
        </div>

        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-action="AddProduct" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Category</strong>
                    <a asp-area="Admin" asp-controller="Category" asp-action="Index"><i class="ti ti-edit"></i></a>
                </div>

                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <p class="fw-bold">Category</p>
                            <select class="form-select" id="categorySelect">
                                <option value="">Select category</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id">@category.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <p class="fw-bold">SubCategory</p>
                            <select asp-for="SubCategoryId" class="form-select" id="subCategorySelect">
                                <option value="">Select subcategory</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><strong>Basic Information</strong></div>
                <div class="card-body">
                    <input asp-for="Name" class="form-control mb-2" placeholder="Product name" />
                    <textarea asp-for="Description" class="form-control mb-2" placeholder="Description"></textarea>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><strong>Images</strong></div>
                <div class="card-body">
                    <input asp-for="Images" type="file" class="form-control" multiple accept="image/*" />
                    <div id="preview" class="d-flex flex-wrap gap-3 mt-3"></div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <strong>Attributes</strong>
                    <a asp-area="Admin" asp-controller="Attribute" asp-action="Index"><i class="ti ti-edit"></i></a>
                </div>

                <div class="card-body">
                    <div id="attributeContainer">
                        <p class="text-muted">Please select a category first</p>
                    </div>

                    <button type="button" class="btn btn-primary" onclick="generateVariants()">
                        Generate Variants
                    </button>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><strong>Variants</strong></div>
                <div class="card-body">
                    <table class="table table-bordered" id="variantTable">
                        <thead>
                            <tr id="variantHeader">
                                <th class="fw-bold">Price</th>
                                <th class="fw-bold">Stock</th>
                                <th class="fw-bold">Attributes</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>

            <button type="submit" class="btn btn-success">Save Product</button>
        </form>
    </div>
</main>

<script src="~/js/product-variants.js" asp-append-version="true"></script>
<script>
    ProductVariants.initAddProduct({
        attributes: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Attributes)),
        subCategories: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SubCategories))
    });
</script>
