@model TechCorner_ECommerce.ViewModels.CreateProductVM
@{
    Layout = "_LayoutDashboard";
}


<main class="content py-4">

    <div class="container-fluid">

        <h2 class="mb-4" >Add Product</h2>
        <div class="row">
            <div class="col-12">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
                    <div class="">
                        <h2  >Add Product</h2>
                        <p class="mb-0">Manage your inventory items</p>
                    </div>

                    <div>
                        <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" class="btn btn-primary">Go to Inventory List</a>
                    </div>
                </div>
            </div>
        </div>

        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-action="AddProduct" method="post" enctype="multipart/form-data">

            @* ================= CATEGORY ================= *@
            <div class="card mb-4">
                <div class="card-header"><strong>Category</strong> <a asp-controller="Category" asp-action="Index" class=""><i class="ti ti-edit "></i></a></div>

                <div class="card-body">

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <p style="font-weight:bolder">Category</p>

                            <select class="form-select" id="categorySelect" style="margin-top: -10px" >
                                <option value="">Select category</option>
                                @foreach (var c in Model.Categories)
                                {
                                    <option value="@c.Id">@c.Name</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <p style="font-weight:bolder ">SubCategory</p>

                            <select asp-for="SubCategoryId"
                                    class="form-select"
                                    id="subCategorySelect" style="margin-top: -10px">
                                <option value="">Select subcategory</option>
                            </select>
                        </div>

                    </div>

                </div>
            </div>

            @* ================= BASIC INFO ================= *@
            <div class="card mb-4">
                <div class="card-header"><strong>Basic Information</strong></div>

                <div class="card-body">

                    <input asp-for="Name"
                           class="form-control mb-2"
                           placeholder="Product name" />

                    <textarea asp-for="Description"
                              class="form-control mb-2"
                              placeholder="Description"></textarea>

                </div>
            </div>


            @* ================= IMAGES ================= *@
            <div class="card mb-4">
                <div class="card-header">
                    <strong>Images</strong>
                </div>

                <div class="card-body">

                    <input asp-for="Images"
                           type="file"
                           class="form-control"
                           multiple
                           accept="image/*" />

                    <div id="preview"
                         class="d-flex flex-wrap gap-3 mt-3">
                    </div>

                </div>
            </div>

            @* ================= ATTRIBUTES ================= *@
            <div class="card mb-4">
                <div class="card-header"><strong>Attributes</strong> <a asp-area="Admin" asp-controller="Attribute" asp-action="Index"><i class="ti ti-edit "></i></a> </div>

                <div class="card-body">
                    <div id="attributeContainer">
                        <p class="text-muted">Please select a category first</p>
                    </div>


                    <button type="button"
                            class="btn btn-primary"
                            onclick="generateVariants()">
                        Generate Variants
                    </button>

                </div>
            </div>

            @* ================= VARIANTS TABLE ================= *@
            <div class="card mb-4">
                <div class="card-header"><strong>Variants</strong></div>

                <div class="card-body">

                    <table class="table table-bordered" id="variantTable">

                        <thead>
                            <tr id="variantHeader">
                                <th class="fw-bold">Price</th>
                                <th class="fw-bold">Stock</th>
                                <th class="fw-bold">Attributes</th>
                            </tr>
                        </thead>

                        <tbody></tbody>

                    </table>

                </div>
            </div>

            <button type="submit" class="btn btn-success">
                Save Product
            </button>

        </form>
    </div>

</main>

<script>

    const attributes = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Attributes))
    const subCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SubCategories))


    // ================= SUBCATEGORY FILTER =================
    document.getElementById("categorySelect")
        .addEventListener("change", function () {

        let catId = parseInt(this.value);

        // subcategory
        let subSelect = document.getElementById("subCategorySelect");

        subSelect.innerHTML = `<option value="">Select subcategory</option>`;

        subCategories
            .filter(x => x.CategoryId === catId)
            .forEach(x => {
                subSelect.innerHTML +=
                    `<option value="${x.Id}">${x.Name}</option>`;
            });

        // render attributes
        renderAttributes(catId);

        // reset variants
        document.querySelector("#variantTable tbody").innerHTML = "";
        document.getElementById("variantHeader").innerHTML =
            `<th class="fw-bold">Price</th><th class="fw-bold">Stock</th>`;
    });

    // ================= IMAGE PREVIEW =================
    const imageInput = document.querySelector('input[type="file"]');
    let selectedFiles = [];

    imageInput.addEventListener("change", function (e) {
        selectedFiles = Array.from(e.target.files);

        renderImagePreview();
    });

    function renderImagePreview() {
        const preview = document.getElementById("preview");

        preview.innerHTML = "";

        selectedFiles.forEach((file, index) => {

            if (file.size > 2 * 1024 * 1024) {
                alert(file.name + " quá lớn (>2MB)");
                selectedFiles.splice(index, 1);
                updateFileInput();
                return;
            }

            const url = URL.createObjectURL(file);

            const wrapper = document.createElement("div");
            wrapper.className = "image-preview-item";

            const img = document.createElement("img");
            img.src = url;
            img.className = "image-preview-img";

            const btn = document.createElement("button");
            btn.type = "button";
            btn.innerHTML = "&times;";
            btn.className = "image-remove-btn";

            btn.onclick = function () {
                URL.revokeObjectURL(url);
                removeSelectedImage(index);
            };

            wrapper.appendChild(img);
            wrapper.appendChild(btn);

            preview.appendChild(wrapper);
        });

        updateFileInput();
    }

        function removeSelectedImage(index) {
            selectedFiles.splice(index, 1);
            renderImagePreview();
        }

        function updateFileInput() {
            const dataTransfer = new DataTransfer();

            selectedFiles.forEach(file => {
                dataTransfer.items.add(file);
            });

            imageInput.files = dataTransfer.files;
        }

    // ================= ATTRIBUTE RENDER =================
    function renderAttributes(catId) {

        const container = document.getElementById("attributeContainer");

        const filtered = attributes.filter(a => a.CategoryId === catId);

        if (filtered.length === 0) {
            container.innerHTML = `<p class="text-muted">No attributes for this category</p>`;
            return;
        }

        container.innerHTML = "";

        filtered.forEach(attr => {

            let html = `
                <div class="mb-3 attribute-group" data-category="${attr.CategoryId}">
                    <label class="fw-bold mb-2 d-block">${attr.Name}</strong></label>
                    <div class="ms-2 mt-1">
            `;

            attr.Values.forEach(val => {
                html += `
                    <div class="form-check form-check-inline">
                        <input type="checkbox"
                               class="attr-checkbox"
                               data-attr="${attr.Id}"
                               value="${val.Id}" />
                        <label class="form-check-label">
                            ${val.Value}
                        </label>
                    </div>
                `;
            });

            html += `</div></div>`;

            container.innerHTML += html;
        });
    }
    // ================= GENERATE VARIANTS =================
    function generateVariants() {

        let selected = {};

        document.querySelectorAll(".attr-checkbox:checked").forEach(cb => {

            let attrId = parseInt(cb.dataset.attr);

            if (!selected[attrId]) selected[attrId] = [];

            selected[attrId].push(parseInt(cb.value));
        });

        let attrArrays = Object.values(selected);

        if (attrArrays.length === 0) {
            alert("Chọn ít nhất 1 attribute");
            return;
        }

        let combos = cartesian(attrArrays);

        renderTable(selected, combos);
    }

    function cartesian(arr) {
        return arr.reduce((a, b) =>
            a.flatMap(d => b.map(e => [...d, e]))
        , [[]]);
    }

function renderTable(selected, combos) {

    let header = document.getElementById("variantHeader");
    let body = document.querySelector("#variantTable tbody");

    header.innerHTML = `
        <th class="fw-bold">Price</th>
        <th class="fw-bold">Stock</th>
        <th class="fw-bold">Attributes</th>
    `;

    body.innerHTML = "";

    combos.forEach((combo, index) => {

        let attrNames = combo
            .map(valId => findValue(valId)?.Value)
            .filter(x => x)
            .join(" / ");

        let row = `<tr>`;

        row += `
            <td>
                <input name="Variants[${index}].Price"
                       class="form-control" />
            </td>
        `;

        row += `
            <td>
                <input name="Variants[${index}].StockQuantity"
                       class="form-control" />
            </td>
        `;

        row += `<td>${attrNames}`;

        combo.forEach(valId => {
            let val = findValue(valId);

            if (!val) return;

            row += `
                <input type="hidden"
                       name="Variants[${index}].AttributeValueIds"
                       value="${val.Id}" />
            `;
        });

        row += `</td>`;

        row += `</tr>`;

        body.innerHTML += row;
    });
}

    function findValue(id) {

        id = parseInt(id);

        for (let attr of attributes) {
            let found = attr.Values.find(v => v.Id === id);
            if (found) return found;
        }

        return null;
    }
</script>






















