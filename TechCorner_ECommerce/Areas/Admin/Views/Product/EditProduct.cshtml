@model TechCorner_ECommerce.ViewModels.EditProductVM

@{
    Layout = "_LayoutDashboard";
    var selectedCategoryId = Model.SubCategories.FirstOrDefault(x => x.Id == Model.SubCategoryId)?.CategoryId;
    var existingVariantKeys = Model.Variants
        .Select(x => string.Join(",", x.AttributeValueIds.OrderBy(id => id)))
        .ToList();
}

<main class="content py-4">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2>Edit Product</h2>
                <p class="text-muted mb-0">Update product information</p>
            </div>

            <a asp-controller="Inventory" asp-action="Index" class="btn btn-light border">Back</a>
        </div>

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form asp-action="EditProduct" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ParentProductId" />

            <div class="card mb-4">
                <div class="card-header"><strong>Category</strong></div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Category</label>
                            <select class="form-control" id="categorySelect" disabled>
                                <option value="">Select category</option>
                                @foreach (var category in Model.Categories)
                                {
                                    <option value="@category.Id" selected="@(selectedCategoryId == category.Id)">
                                        @category.Name
                                    </option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">SubCategory</label>
                            <select asp-for="SubCategoryId" class="form-select" id="subCategorySelect"></select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><strong>Basic Information</strong></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Product Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div>
                        <label class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="form-control"></textarea>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><strong>Current Images</strong></div>
                <div class="card-body">
                    <div id="existingPreview" class="d-flex flex-wrap gap-3">
                        @foreach (var img in Model.ExistingImages)
                        {
                            <div class="image-preview-item" id="image-@img.Id">
                                <img src="@img.ImageUrl" class="image-preview-img" />
                                <button type="button"
                                        class="image-remove-btn"
                                        onclick="openDeleteImageModal(@img.Id)">
                                    &times;
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><strong>Add More Images</strong></div>
                <div class="card-body">
                    <input asp-for="NewImages" type="file" class="form-control" multiple accept="image/*" />
                    <div id="newPreview" class="d-flex flex-wrap gap-3 mt-3"></div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><strong>Add New Variants</strong></div>
                <div class="card-body">
                    <div id="attributeContainer">
                        <p class="text-muted">Loading attributes...</p>
                    </div>

                    <button type="button" class="btn btn-primary mt-2" onclick="generateVariants()">
                        Generate Variants
                    </button>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header"><strong>Variants</strong></div>
                <div class="card-body">
                    <table class="table table-bordered" id="variantTable">
                        <thead>
                            <tr id="variantHeader">
                                <th class="fw-bold">Price</th>
                                <th class="fw-bold">Stock</th>
                                <th class="fw-bold">Attributes</th>
                                <th class="fw-bold">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (int i = 0; i < Model.Variants.Count; i++)
                            {
                                var names = Model.Variants[i].AttributeValueIds
                                    .SelectMany(valId => Model.Attributes
                                        .SelectMany(attr => attr.Values)
                                        .Where(value => value.Id == valId)
                                        .Select(value => value.Value))
                                    .ToList();

                                <tr>
                                    <td>
                                        <input type="hidden" asp-for="Variants[i].ProductId" />
                                        <input asp-for="Variants[i].Price" class="form-control" />
                                    </td>

                                    <td>
                                        <input asp-for="Variants[i].StockQuantity" class="form-control" />
                                    </td>

                                    <td>
                                        @string.Join(" / ", names)

                                        @foreach (var val in Model.Variants[i].AttributeValueIds)
                                        {
                                            <input type="hidden"
                                                   name="Variants[@i].AttributeValueIds"
                                                   value="@val" />
                                        }
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="btn p-0 border-0 bg-transparent link-danger"
                                                onclick="openDeleteModal(@Model.Variants[i].ProductId)">
                                            <i class="ti ti-trash ms-2"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <button class="btn btn-warning">Save Changes</button>
        </form>
    </div>

    <div class="modal fade" id="deleteModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5>Delete Variant</h5></div>
                <div class="modal-body">
                    Are you sure delete <strong>this Variant</strong>?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" id="confirmDelete">Delete</button>
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteImageModal">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header"><h5>Delete Image</h5></div>
                <div class="modal-body">
                    Are you sure delete <strong>this image</strong>?
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" id="confirmDeleteImage">Delete</button>
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
</main>

<script src="~/js/product-variants.js" asp-append-version="true"></script>
<script>
    ProductVariants.initEditProduct({
        attributes: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Attributes)),
        subCategories: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SubCategories)),
        selectedSubId: @Model.SubCategoryId,
        variantIndex: @Model.Variants.Count,
        existingVariantKeys: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(existingVariantKeys))
    });
</script>

<partial name="_ValidationScriptsPartial" />
