@model TechCorner_ECommerce.ViewModels.EditProductVM

@{
    Layout = "_LayoutDashboard";
}

<main class="content py-4">

<div class="container-fluid">
    <h2 class="mb-4" >Add Product</h2>
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Edit Product</h2>
            <p class="text-muted mb-0">
                Update product information
            </p>
        </div>

        <a asp-controller="Inventory"
           asp-action="Index"
           class="btn btn-light border">
            Back
        </a>

    </div>

    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <form asp-action="EditProduct" method="post" enctype="multipart/form-data">

        <input type="hidden" asp-for="ParentProductId" />

        @* ================= CATEGORY ================= *@
        <div class="card mb-4">

            <div class="card-header">
                <strong>Category</strong>
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Category
                        </label>

                        <select class="form-control"
                                id="categorySelect" disabled>

                            <option value="">
                                Select category
                            </option>

                            @foreach (var c in Model.Categories)
                            {
                                var selected =
                                    Model.SubCategories
                                    .FirstOrDefault(x => x.Id == Model.SubCategoryId)?
                                    .CategoryId == c.Id;

                                <option value="@c.Id"
                                        selected="@selected">
                                    @c.Name
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            SubCategory
                        </label>

                        <select asp-for="SubCategoryId"
                                class="form-select"
                                id="subCategorySelect">

                        </select>

                    </div>

                </div>

            </div>

        </div>

        @* ================= BASIC ================= *@
        <div class="card mb-4">

            <div class="card-header">
                <strong>Basic Information</strong>
            </div>

            <div class="card-body">

                <div class="mb-3">

                    <label class="form-label fw-semibold">
                        Product Name
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger"></span>

                </div>

                <div>

                    <label class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"></textarea>

                </div>

            </div>

        </div>

        @* ================= EXISTING IMAGES ================= *@
        <div class="card mb-4">

            <div class="card-header">
                <strong>Current Images</strong>
            </div>

            <div class="card-body">

                <div id="existingPreview"
                     class="d-flex flex-wrap gap-3">

                    @foreach (var img in Model.ExistingImages)
                    {
                        <div class="image-preview-item"
                             id="image-@img.Id">

                            <img src="@img.ImageUrl"
                                 class="image-preview-img" />

                            <button type="button"
                                    class="image-remove-btn"
                                    onclick="openDeleteImageModal(@img.Id)">
                                &times;
                            </button>

                        </div>
                    }
                </div>

            </div>

        </div>

        @* ================= NEW IMAGES ================= *@
        <div class="card mb-4">

            <div class="card-header">
                <strong>Add More Images</strong>
            </div>

            <div class="card-body">

                <input asp-for="NewImages"
                       type="file"
                       class="form-control"
                       multiple />
                <div id="newPreview"
                     class="d-flex flex-wrap gap-3 mt-3">
                </div>

            </div>

        </div>

        @* ================= ATTRIBUTES ================= *@
        <div class="card mb-4">
            <div class="card-header">
                <strong>Add New Variants</strong>
            </div>

            <div class="card-body">
                <div id="attributeContainer">
                    <p class="text-muted">Loading attributes...</p>
                </div>

                <button type="button"
                        class="btn btn-primary mt-2"
                        onclick="generateVariants()">
                    Generate Variants
                </button>
            </div>
        </div>

        @* ================= VARIANTS ================= *@
        <div class="card mb-4">
            <div class="card-header">
                <strong>Variants</strong>
            </div>

            <div class="card-body">

                <table class="table table-bordered" id="variantTable">

                    <thead>
                        <tr id="variantHeader">
                            <th class="fw-bold">Price</th>
                            <th class="fw-bold">Stock</th>
                            <th class="fw-bold">Attributes</th>
                            <th class="fw-bold">Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @for (int i = 0; i < Model.Variants.Count; i++)
                        {
                            <tr>
                                <td>
                                    <input type="hidden"
                                            asp-for="Variants[i].ProductId" />

                                    <input asp-for="Variants[i].Price"
                                            class="form-control" />
                                </td>

                                <td>
                                    <input asp-for="Variants[i].StockQuantity"
                                            class="form-control" />
                                </td>

                                <td>
                                    @{
                                        var names = new List<string>();

                                        foreach (var valId in Model.Variants[i].AttributeValueIds)
                                        {
                                            foreach (var attr in Model.Attributes)
                                            {
                                                var found = attr.Values.FirstOrDefault(x => x.Id == valId);

                                                if (found != null)
                                                {
                                                    names.Add(found.Value);
                                                }
                                            }
                                        }
                                    }

                                    @string.Join(" / ", names)

                                    @foreach (var val in Model.Variants[i].AttributeValueIds)
                                    {
                                        <input type="hidden"
                                                name="Variants[@i].AttributeValueIds"
                                                value="@val" />
                                    }
                                </td>
                                    <td class="">

                                        <button type="button" class="btn p-0 border-0 bg-transparent link-danger" onclick="openDeleteModal(@Model.Variants[i].ProductId, '@Model.Name')">

                                            <i class="ti ti-trash ms-2"></i>

                                        </button>

                                    </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>

        <button class="btn btn-warning">
            Save Changes
        </button>

    </form>

</div>
    <!-- DELETE MODAL -->
    <div class="modal fade" id="deleteModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5>Delete Variant</h5>

                </div>

                <div class="modal-body">

                    Are you sure delete 
                    <strong>this Variant</strong> 
                    @* <strong id="productName"></strong> ? *@

                </div>

                <div class="modal-footer">

                    <button class="btn btn-danger" id="confirmDelete">
                        Delete
                    </button>

                    <button class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                </div>

            </div>

        </div>

    </div>

    <!-- DELETE IMAGE MODAL -->
    <div class="modal fade" id="deleteImageModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5>Delete Image</h5>

                </div>

                <div class="modal-body">

                    Are you sure delete
                    <strong>this image</strong> ?

                </div>

                <div class="modal-footer">

                    <button class="btn btn-danger"
                            id="confirmDeleteImage">
                        Delete
                    </button>

                    <button class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                </div>

            </div>

        </div>

    </div>
</main>

<script>
    // ================= GENERATE VARIANTS =================
    const subCategories =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SubCategories));

    const attributes =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Attributes));

    const selectedSub = @Model.SubCategoryId;

    let variantIndex = @Model.Variants.Count;

    function loadSubcategories(catId) {
        let subSelect = document.getElementById("subCategorySelect");

        subSelect.innerHTML = `<option value="">Select subcategory</option>`;

        subCategories
            .filter(x => x.CategoryId == catId)
            .forEach(x => {
                let selected = x.Id == selectedSub ? "selected" : "";

                subSelect.innerHTML += `
                    <option value="${x.Id}" ${selected}>
                        ${x.Name}
                    </option>
                `;
            });
    }

    const categorySelect = document.getElementById("categorySelect");

    loadSubcategories(categorySelect.value);
    renderAttributes(parseInt(categorySelect.value));

    function renderAttributes(catId) {
        const container = document.getElementById("attributeContainer");

        const filtered = attributes.filter(a => a.CategoryId === catId);

        if (filtered.length === 0) {
            container.innerHTML = `<p class="text-muted">No attributes for this category</p>`;
            return;
        }

        container.innerHTML = "";

        filtered.forEach(attr => {
            let html = `
                <div class="mb-3 attribute-group">
                    <label class="fw-bold mb-2 d-block">${attr.Name}</label>
                    <div class="ms-2 mt-1">
            `;

            attr.Values.forEach(val => {
                html += `
                    <div class="form-check form-check-inline">
                        <input type="checkbox"
                               class="attr-checkbox"
                               data-attr="${attr.Id}"
                               value="${val.Id}" />
                        <label class="form-check-label">
                            ${val.Value}
                        </label>
                    </div>
                `;
            });

            html += `</div></div>`;

            container.innerHTML += html;
        });
    }

    function generateVariants() {
        let selected = {};

        document.querySelectorAll(".attr-checkbox:checked").forEach(cb => {
            let attrId = parseInt(cb.dataset.attr);

            if (!selected[attrId]) selected[attrId] = [];

            selected[attrId].push(parseInt(cb.value));
        });

        let attrArrays = Object.values(selected);

        if (attrArrays.length === 0) {
            alert("Chọn ít nhất 1 attribute");
            return;
        }

        let combos = cartesian(attrArrays);

        appendNewVariants(combos);
    }

    function cartesian(arr) {
        return arr.reduce((a, b) =>
            a.flatMap(d => b.map(e => [...d, e]))
        , [[]]);
    }

    const existingVariantKeys = new Set([
    @foreach (var variant in Model.Variants)
    {
        var key = string.Join(",", variant.AttributeValueIds.OrderBy(x => x));
        <text>"@key",</text>
    }
    ]);

    const generatedVariantKeys = new Set();

function appendNewVariants(combos) {
    let body = document.querySelector("#variantTable tbody");

    let addedCount = 0;
    let duplicatedCount = 0;

    combos.forEach(combo => {
        let comboKey = combo
            .map(x => parseInt(x))
            .sort((a, b) => a - b)
            .join(",");

        if (existingVariantKeys.has(comboKey) || generatedVariantKeys.has(comboKey)) {
            duplicatedCount++;
            return;
        }

        let attrNames = combo.map(id => findValue(id)?.Value).join(" / ");

        let row = `<tr>`;

        row += `
            <td>
                <input type="hidden"
                       name="Variants[${variantIndex}].ProductId"
                       value="0" />

                <input name="Variants[${variantIndex}].Price"
                       class="form-control" />
            </td>
        `;

        row += `
            <td>
                <input name="Variants[${variantIndex}].StockQuantity"
                       class="form-control" />
            </td>
        `;

        row += `<td>${attrNames}`;

        combo.forEach(valId => {
            row += `
                <input type="hidden"
                       name="Variants[${variantIndex}].AttributeValueIds"
                       value="${valId}" />
            `;
        });

        row += `</td></tr>`;

        body.innerHTML += row;

        generatedVariantKeys.add(comboKey);
        addedCount++;
        variantIndex++;
    });

    if (addedCount === 0 && duplicatedCount > 0) {
        alert("Không generate được vì combo attribute này đã tồn tại.");
        return;
    }

    if (duplicatedCount > 0) {
        alert(`Đã bỏ qua ${duplicatedCount} combo bị trùng.`);
    }
}

    function findValue(id) {
        id = parseInt(id);

        for (let attr of attributes) {
            let found = attr.Values.find(v => v.Id === id);
            if (found) return found;
        }

        return null;
    }

    // ================= NEW IMAGE PREVIEW =================
    const imageInput = document.querySelector('input[type="file"]');

    let selectedFiles = [];

    imageInput.addEventListener("change", function (e) {

        selectedFiles = Array.from(e.target.files);

        renderImagePreview();
    });

    function renderImagePreview() {

        const preview =
            document.getElementById("newPreview");

        preview.innerHTML = "";

        selectedFiles.forEach((file, index) => {

            if (file.size > 2 * 1024 * 1024) {

                alert(file.name + " quá lớn (>2MB)");

                selectedFiles.splice(index, 1);

                updateFileInput();

                return;
            }

            const url = URL.createObjectURL(file);

            const wrapper = document.createElement("div");

            wrapper.className = "image-preview-item";

            const img = document.createElement("img");

            img.src = url;

            img.className = "image-preview-img";

            const btn = document.createElement("button");

            btn.type = "button";

            btn.innerHTML = "&times;";

            btn.className = "image-remove-btn";

            btn.onclick = function () {

                URL.revokeObjectURL(url);

                removeSelectedImage(index);
            };

            wrapper.appendChild(img);

            wrapper.appendChild(btn);

            preview.appendChild(wrapper);
        });

        updateFileInput();
    }

    function removeSelectedImage(index) {

        selectedFiles.splice(index, 1);

        renderImagePreview();
    }

    function updateFileInput() {

        const dataTransfer = new DataTransfer();

        selectedFiles.forEach(file => {
            dataTransfer.items.add(file);
        });

        imageInput.files = dataTransfer.files;
    }
    // ================= DELETE IMAGE =================
    let deleteImageId = 0;

    function openDeleteImageModal(id) {

        deleteImageId = id;

        let modal = new bootstrap.Modal(
            document.getElementById("deleteImageModal")
        );

        modal.show();
    }

    document.getElementById("confirmDeleteImage")
        .addEventListener("click", function () {

        const formData = new FormData();

        formData.append("id", deleteImageId);

        fetch('/Admin/Product/DeleteImage', {

            method: 'POST',

            body: formData

        })
        .then(r => r.json())
        .then(res => {

            if (res.success) {

                document
                    .getElementById(`image-${deleteImageId}`)
                    .remove();

                bootstrap.Modal
                    .getInstance(document.getElementById("deleteImageModal"))
                    .hide();

            } else {

                alert(res.message);
            }
        });
    });

    // ================= DELETE VARIANT =================
    let deleteId = 0;

    function openDeleteModal(id, name) {

        deleteId = id;

        //document.getElementById("productName").innerText = name;

        let modal = new bootstrap.Modal(
            document.getElementById("deleteModal")
        );

        modal.show();
    }

    document.getElementById("confirmDelete")
        .addEventListener("click", function () {

        const formData = new FormData();

        formData.append("id", deleteId);

        fetch('/Admin/Product/DeleteVariant', {

            method: 'POST',

            body: formData

        })
        .then(r => r.json())
        .then(res => {

            if (res.success) {

                location.reload();

            } else {

                alert(res.message);
            }
        });

    });
</script>

<partial name="_ValidationScriptsPartial" />