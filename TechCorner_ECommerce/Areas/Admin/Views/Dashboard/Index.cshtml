@model TechCorner_ECommerce.ViewModels.DashboardVM
@using TechCorner_ECommerce.Models.Enums

@{
    Layout = "_LayoutDashboard";
    var maxRevenue = Model.MonthlySales.Any() ? Model.MonthlySales.Max(x => x.Revenue) : 0m;
    var maxOrders = Model.MonthlySales.Any() ? Model.MonthlySales.Max(x => x.OrderCount) : 0;
}

<style>
    .dashboard-product-img {
        width: 52px;
        height: 52px;
        object-fit: cover;
        background: #f8fafc;
    }

    .dashboard-bar {
        min-height: 190px;
    }

    .dashboard-bar-track {
        height: 148px;
        width: 18px;
        background: #f1f5f9;
        border-radius: 999px;
        display: flex;
        align-items: end;
        overflow: hidden;
    }

    .dashboard-bar-fill {
        width: 100%;
        min-height: 4px;
        border-radius: 999px;
    }

    .dashboard-mini-stat {
        background: #f8fafc;
        border: 1px solid #edf2f7;
        border-radius: 8px;
    }
</style>

<!-- MAIN CONTENT -->
<main id="content" class="content py-10">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="mb-6">
                    <h1 class="fs-3 mb-1 fw-bold">Dashboard</h1>
                    <p class="text-muted mb-0">Theo dõi doanh thu, đơn hàng và tồn kho của TechCorner.</p>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-lg-3 col-12">
                <div class="card p-4 bg-primary bg-opacity-10 border border-primary border-opacity-25 rounded-2">
                    <div class="d-flex gap-3">
                        <div class="icon-shape icon-md bg-primary text-white rounded-2">
                            <i class="ti ti-report-analytics fs-4"></i>
                        </div>
                        <div>
                            <h2 class="mb-3 fs-6">@Model.TotalSales.Label</h2>
                            <h3 class="fw-bold mb-0">@Model.TotalSales.Value</h3>
                            <p class="@(Model.TotalSales.IsPositiveChange ? "text-primary" : "text-danger") mb-0 small">@Model.TotalSales.ChangeText</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-12">
                <div class="card p-4 bg-success bg-opacity-10 border border-success border-opacity-25 rounded-2">
                    <div class="d-flex gap-3">
                        <div class="icon-shape icon-md bg-success text-white rounded-2">
                            <i class="ti ti-shopping-cart fs-4"></i>
                        </div>
                        <div>
                            <h2 class="mb-3 fs-6">@Model.TotalOrders.Label</h2>
                            <h3 class="fw-bold mb-0">@Model.TotalOrders.Value</h3>
                            <p class="@(Model.TotalOrders.IsPositiveChange ? "text-success" : "text-danger") mb-0 small">@Model.TotalOrders.ChangeText</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-12">
                <div class="card p-4 bg-info bg-opacity-10 border border-info border-opacity-25 rounded-2">
                    <div class="d-flex gap-3">
                        <div class="icon-shape icon-md bg-info text-white rounded-2">
                            <i class="ti ti-package fs-4"></i>
                        </div>
                        <div>
                            <h2 class="mb-3 fs-6">@Model.TotalProducts.Label</h2>
                            <h3 class="fw-bold mb-0">@Model.TotalProducts.Value</h3>
                            <p class="@(Model.TotalProducts.IsPositiveChange ? "text-info" : "text-danger") mb-0 small">@Model.TotalProducts.ChangeText</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-12">
                <div class="card p-4 bg-warning bg-opacity-10 border border-warning border-opacity-25 rounded-2">
                    <div class="d-flex gap-3">
                        <div class="icon-shape icon-md bg-warning text-white rounded-2">
                            <i class="ti ti-alert-triangle fs-4"></i>
                        </div>
                        <div>
                            <h2 class="mb-3 fs-6">@Model.LowStock.Label</h2>
                            <h3 class="fw-bold mb-0">@Model.LowStock.Value</h3>
                            <p class="@(Model.LowStock.IsPositiveChange ? "text-success" : "text-warning") mb-0 small">@Model.LowStock.ChangeText</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-lg-4 col-12">
                <div class="card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between border-bottom pb-5 mb-3">
                            <div>
                                <h3 class="fw-bold h4">@Currency(Model.DeliveredRevenue)</h3>
                                <span>Delivered Revenue</span>
                            </div>
                            <i class="ti ti-circle-check fs-1 text-success"></i>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small">
                            <div class="text-muted">Tính từ đơn đã giao</div>
                            <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="@OrderStatus.Delivered" class="link-primary text-decoration-underline">View</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-12">
                <div class="card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between border-bottom pb-5 mb-3">
                            <div>
                                <h3 class="fw-bold h4">@Currency(Model.PendingRevenue)</h3>
                                <span>Pending Revenue</span>
                            </div>
                            <i class="ti ti-clock fs-1 text-warning"></i>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small">
                            <div class="text-muted">Đơn đang chờ xử lý</div>
                            <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="@OrderStatus.Pending" class="link-primary text-decoration-underline">View</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-12">
                <div class="card">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between border-bottom pb-5 mb-3">
                            <div>
                                <h3 class="fw-bold h4">@Currency(Model.CancelledRevenue)</h3>
                                <span>Cancelled Revenue</span>
                            </div>
                            <i class="ti ti-ban fs-1 text-danger"></i>
                        </div>
                        <div class="d-flex justify-content-between align-items-center small">
                            <div class="text-muted">Giá trị đơn đã hủy</div>
                            <a asp-area="Admin" asp-controller="Order" asp-action="Index" asp-route-status="@OrderStatus.Cancelled" class="link-primary text-decoration-underline">View</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center bg-transparent px-4 py-3">
                        <h3 class="h5 mb-0">Sales Overview</h3>
                        <span class="badge bg-primary-subtle text-primary border border-primary">Last 6 months</span>
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-end gap-3 dashboard-bar">
                            @foreach (var item in Model.MonthlySales)
                            {
                                var revenueHeight = maxRevenue == 0 ? 4 : Math.Max(4, (int)Math.Round(item.Revenue * 130 / maxRevenue));
                                var orderHeight = maxOrders == 0 ? 4 : Math.Max(4, (int)Math.Round(item.OrderCount * 130m / maxOrders));

                                <div class="text-center flex-fill">
                                    <div class="d-flex justify-content-center align-items-end gap-1 mb-2">
                                        <div class="dashboard-bar-track">
                                            <div class="dashboard-bar-fill bg-primary" style="height:@(revenueHeight)px"></div>
                                        </div>
                                        <div class="dashboard-bar-track">
                                            <div class="dashboard-bar-fill bg-warning" style="height:@(orderHeight)px"></div>
                                        </div>
                                    </div>
                                    <small class="d-block text-muted">@item.MonthLabel</small>
                                    <small class="d-block fw-semibold">@Currency(item.Revenue)</small>
                                    <small class="d-block text-muted">@item.OrderCount orders</small>
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-3 mt-3 small text-muted">
                            <span><i class="ti ti-square-filled text-primary"></i> Revenue</span>
                            <span><i class="ti ti-square-filled text-warning"></i> Orders</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-6">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center bg-transparent px-4 py-3">
                        <h3 class="h5 mb-0">Overall Information</h3>
                        <span class="badge bg-light text-dark border">Live data</span>
                    </div>
                    <div class="card-body p-4">
                        <h3 class="h6">Customers Overview</h3>
                        <div class="row align-items-center">
                            <div class="col-sm-6">
                                <div class="dashboard-mini-stat p-4 text-center">
                                    <i class="ti ti-users fs-1 text-primary"></i>
                                    <h2 class="mb-1 mt-3">@Model.TotalCustomers.ToString("N0")</h2>
                                    <p class="text-muted mb-0">Total customers</p>
                                </div>
                            </div>
                            <div class="col-sm-6">
                                <div class="row">
                                    <div class="col-6 border-end">
                                        <div class="text-center">
                                            <h2 class="mb-1">@Model.FirstTimeCustomers.ToString("N0")</h2>
                                            <p class="text-success mb-2">First Time</p>
                                            <span class="badge bg-success">@Percent(Model.FirstTimeCustomers, Model.FirstTimeCustomers + Model.ReturningCustomers)</span>
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="text-center">
                                            <h2 class="mb-1">@Model.ReturningCustomers.ToString("N0")</h2>
                                            <p class="text-warning mb-2">Return</p>
                                            <span class="badge bg-warning text-dark">@Percent(Model.ReturningCustomers, Model.FirstTimeCustomers + Model.ReturningCustomers)</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row text-center border-top mt-4 pt-4">
                            <div class="col-4 border-end">
                                <h3 class="fw-bold mb-2">@Model.TotalProductVariants.ToString("N0")</h3>
                                <small class="text-secondary">Variants</small>
                            </div>
                            <div class="col-4 border-end">
                                <h3 class="fw-bold mb-2">@Model.TotalCustomers.ToString("N0")</h3>
                                <small class="text-secondary">Customers</small>
                            </div>
                            <div class="col-4">
                                <h3 class="fw-bold mb-2">@Model.TotalOrders.Value</h3>
                                <small class="text-secondary">Orders</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center px-4 py-3">
                        <h4 class="mb-0 h5">Top Selling Products</h4>
                        <span class="badge bg-light text-dark border">All time</span>
                    </div>

                    <ul class="list-group list-group-flush">
                        @if (Model.TopSellingProducts.Any())
                        {
                            foreach (var item in Model.TopSellingProducts)
                            {
                                <li class="list-group-item d-flex align-items-center gap-3">
                                    <img src="@ProductImage(item.ImageUrl)" class="rounded dashboard-product-img" alt="@item.ProductName">
                                    <div class="flex-grow-1">
                                        <p class="mb-1 fw-semibold">@item.ProductName</p>
                                        <div class="d-flex align-items-center gap-2 text-muted">
                                            <small class="fw-semibold">@Currency(item.Revenue)</small>
                                            <small>•</small>
                                            <small>@item.UnitsSold.ToString("N0") Units</small>
                                        </div>
                                    </div>
                                    <span class="badge bg-primary-subtle text-primary border border-primary">@item.SalesSharePercent.ToString("0.#")%</span>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-muted">Chưa có dữ liệu bán hàng.</li>
                        }
                    </ul>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center px-4 py-3">
                        <h4 class="mb-0 h5">Low Stock Products</h4>
                        <a asp-area="Admin" asp-controller="Inventory" asp-action="Index" class="small text-primary text-decoration-underline">View All</a>
                    </div>

                    <ul class="list-group list-group-flush">
                        @if (Model.LowStockProducts.Any())
                        {
                            foreach (var item in Model.LowStockProducts)
                            {
                                <li class="list-group-item d-flex align-items-center gap-3">
                                    <img src="@ProductImage(item.ImageUrl)" class="rounded dashboard-product-img" alt="@item.ProductName">
                                    <div class="flex-grow-1">
                                        <p class="mb-1 fw-semibold">@item.ProductName</p>
                                        <small>ID: @item.SkuCode</small>
                                    </div>
                                    <div class="d-flex flex-column gap-0 align-items-center">
                                        <span class="fw-semibold @(item.StockQuantity <= 0 ? "text-danger" : "text-primary")">@item.StockQuantity.ToString("N0")</span>
                                        <small class="text-muted">In Stock</small>
                                    </div>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-muted">Chưa có sản phẩm nào.</li>
                        }
                    </ul>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center px-4 py-3">
                        <h4 class="mb-0 h5">Recent Orders</h4>
                        <a asp-area="Admin" asp-controller="Order" asp-action="Index" class="small text-primary text-decoration-underline">View All</a>
                    </div>

                    <ul class="list-group list-group-flush">
                        @if (Model.RecentOrders.Any())
                        {
                            foreach (var item in Model.RecentOrders)
                            {
                                <li class="list-group-item d-flex align-items-center gap-3">
                                    <img src="@ProductImage(item.ImageUrl)" class="rounded dashboard-product-img" alt="@item.ProductName">
                                    <div class="flex-grow-1">
                                        <p class="mb-1 fw-semibold">@item.ProductName</p>
                                        <div class="d-flex align-items-center gap-2 text-muted">
                                            <small class="fw-semibold">#@item.OrderCode</small>
                                            <small>•</small>
                                            <small>@Currency(item.TotalPrice)</small>
                                        </div>
                                        <small class="text-muted">@item.CustomerName • @item.ItemCount items</small>
                                    </div>
                                    <span class="badge @OrderStatusBadge(item.Status)">@item.Status</span>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="list-group-item text-muted">Chưa có đơn hàng nào.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <footer class="text-center py-2 mt-6 text-secondary">
                    <p class="mb-0">Copyright © 2026 InApp Inventory Dashboard.</p>
                </footer>
            </div>
        </div>
    </div>
</main>

@functions {
    private static string Currency(decimal value) {
        return $"{value:N0}đ";
    }

    private static string Percent(int value, int total) {
        return total == 0 ? "0%" : $"{Math.Round(value * 100m / total, 1):0.#}%";
    }

    private static string ProductImage(string imageUrl) {
        return string.IsNullOrWhiteSpace(imageUrl)
            ? "/Admin/assets/images/product-1.png"
            : imageUrl;
    }

    private static string OrderStatusBadge(OrderStatus status) {
        return status switch {
            OrderStatus.Pending => "bg-warning text-dark",
            OrderStatus.Confirmed => "bg-info",
            OrderStatus.Shipping => "bg-primary",
            OrderStatus.Delivered => "bg-success",
            OrderStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
    }
}
