@model IEnumerable<TechCorner_ECommerce.ViewModels.MenuCategoryVM>

@{
    Layout = "_LayoutDashboard";
}

<main class="content py-4">

    <div class="container-fluid">

        <h2 class="mb-4" >Categories</h2>
 


        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="mb-1">Categories</h2>
                <p class="text-muted mb-0">
                    Manage product categories
                </p>
            </div>

            <div>
                <a asp-action="Create"
                   class="btn btn-primary">
                    Add Category
                </a>

                <a asp-controller="SubCategory" asp-action="Index"
                   class="btn btn-primary" >
                    Go to Sub-category
                </a>

                <a asp-controller="Product" asp-action="AddProduct"
                   class="btn btn-light border">
                    Back
                </a>
            </div>

        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <!-- FILTER -->
        <form method="get" class="row mb-3">

            <div class="col-md-4">
                <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search Category..." />
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary">Filter</button>
            </div>

        </form> 

        <div class="card">

            <div class="card-header">
                <strong>Category List</strong>
            </div>

            <div class="card-body">

                    <table class="table mb-0 text-nowrap table-hover">

                    <thead class="table-light border-light">

                        <tr>

                            <th>ID</th>

                            <th>Category</th>

                            <th >Products</th>

                            <th>Created</th>

                            <th>SubCategories</th>

                            <th width="120">Action</th>

                        </tr>

                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="align-middle">

                                <td>
                                    #@item.Id
                                </td>

                                <td>
                                    <div >
                                        @item.Name
                                    </div>
                                </td>

                                <td class="text-center">
                                    <span class="badge bg-primary  ">
                                        @item.ProductCount
                                    </span>
                                </td>

                                <td>
                                    @item.CreatedAt.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @if (item.SubCategories.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-2">

                                            @foreach (var subcate in item.SubCategories)
                                            {
                                                <span class="badge bg-light text-dark border px-3 py-2">

                                                    @subcate.Name

                                                </span>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            No subcategories
                                        </span>
                                    }

                                </td>

                                <td>

                                    <div class="d-flex align-items-center">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="text-warning fs-5">

                                            <i class="ti ti-edit"></i>

                                        </a>


                                        <input type="hidden"
                                                name="id"
                                                value="@item.Id" />

                                        <button 
                                                class="btn p-0 border-0 bg-transparent link-danger"
                                                onclick="openDeleteModal(@item.Id, '@item.Name', @item.ProductCount)">

                                            <i class="ti ti-trash"></i>

                                        </button>


                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- DELETE MODAL -->
    <div class="modal fade" id="deleteModal">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5>Delete SubCategory</h5>
                </div>

                <div class="modal-body">
                    Are you sure delete <strong id="subName"></strong> ?

                    <p class="text-danger mt-2" id="warningText"></p>
                </div>

                <div class="modal-footer">

                    <button class="btn btn-danger" id="confirmDelete">
                        Delete
                    </button>

                    <button class="btn btn-secondary" data-bs-dismiss="modal">
                        Cancel
                    </button>

                </div>

            </div>
        </div>
    </div>

</main>

<script>

    let deleteId = 0;
    let canDelete = true;

    function openDeleteModal(id, name, productCount) {

        deleteId = id;

        document.getElementById("catName").innerText = name;

        const warning =
            document.getElementById("warningText");

        if (productCount > 0) {

            canDelete = false;

            warning.innerText =
                "Cannot delete because it has products";

        } else {

            canDelete = true;

            warning.innerText = "";
        }

        new bootstrap.Modal(
            document.getElementById("deleteModal")
        ).show();
    }

    document.getElementById("confirmDelete")
        .addEventListener("click", function () {

        if (!canDelete) return;

        const formData = new FormData();

        formData.append("id", deleteId);

        fetch('/Admin/Category/Delete', {
            method: 'POST',
            body: formData
        })
        .then(r => r.json())
        .then(res => {

            if (res.success) {

                location.reload();

            } else {

                alert(res.message);
            }
        });
    });

</script>