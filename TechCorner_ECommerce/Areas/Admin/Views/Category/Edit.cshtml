@model TechCorner_ECommerce.ViewModels.CategoryEditVM

@{
    Layout = "_LayoutDashboard";
}

<main class="content py-4">

    <div class="container-fluid">
        <h2 class="mb-4" >Edit Categories</h2>
        <div class="d-flex justify-content-between align-items-center mb-4">

            <div>
                <h2 class="mb-1">Edit Category</h2>
                <p class="text-muted mb-0">
                    Update category information
                </p>
            </div>

            <a asp-action="Index"
               class="btn btn-light border">
                Back
            </a>

        </div>

        <div class="card">

            <div class="card-header">
                <strong>Category Form</strong>
            </div>

            <div class="card-body">

                <form method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden"
                           asp-for="CategoryId" />

                    <!-- NAME -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Category Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter category name" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>

                    </div>

                    <!-- CREATED DATE (readonly) -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Created Date
                        </label>

                        <input class="form-control"
                               value="@Model.CreatedAt.ToString("dd/MM/yyyy")"
                               disabled />

                    </div>
                    <!-- UPDATED DATE (readonly) -->
                    <div class="mb-3">

                        <label class="form-label fw-semibold">
                            Updated Date
                        </label>

                        <input class="form-control"
                               value="@Model.UpdatedAt.ToString("dd/MM/yyyy")"
                               disabled />

                    </div>

                    <!-- BUTTONS -->
                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            Update Category

                        </button>

                        <a asp-action="Index"
                           class="btn btn-light border">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</main>