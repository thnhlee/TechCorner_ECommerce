
@{
    Layout = "_LayoutCustomer";
}

@RenderSection("lib", required: false)

@RenderSection("breadcrumbs", required: false)

<section class="ftco-section bg-light">
    <div class="container">
        <div class="row">
            <div class="col-md-8 col-lg-10 order-md-last">
                <div class="row">
					@RenderBody()
                </div>

                <partial name="_Paging" model="Model" />

            </div>

	    @await Component.InvokeAsync("MenuCategory")
        </div>
    </div>
</section>

@RenderSection("Scripts", required: false)