@using System.Text.Json
@model TechCorner_ECommerce.ViewModels.ProductVM
@{
    ViewData["Title"] = Model.Name;
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
<link rel="stylesheet" href="~/css/ProductDetail.css" asp-append-version="true" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script>
    window.productVariants = @Html.Raw(JsonSerializer.Serialize(Model.Variants));
</script>
<script src="~/js/DetailProd.js"></script>

<div class="hero-wrap hero-bread product-detail-hero" style="background-image: url('/Hinh/Pulsar-FS1-2800px.webp');">
    <div class="container">
        <div class="row no-gutters slider-text align-items-end">
            <div class="col-md-9 pb-5">
                <p class="breadcrumbs">
                    <span class="mr-2"><a asp-controller="Home" asp-action="Index">Home</a></span>
                    <span class="mr-2"><a asp-controller="Product" asp-action="Index">Shop</a></span>
                    <span>@Model.Name</span>
                </p>
                <h1 class="mb-0 bread">@Model.Name</h1>
            </div>
        </div>
    </div>
</div>

<section class="ftco-section product-detail-section">
    <div class="container">
        <div class="product-detail-shell">
            <div class="product-gallery-panel ftco-animate">
                <a asp-controller="Product" asp-action="Detail" asp-route-id="@Model.Slug" class="product-detail-image-link">
                    <img src="@Model.ImageUrl" class="product-detail-image" alt="@Model.Name">
                </a>
            </div>

            <div class="product-info-panel product-details ftco-animate">
                <div class="product-meta-row">
                    <span class="product-category-chip">@Model.CategoryName</span>
                    @if (!string.IsNullOrWhiteSpace(Model.SubCategoryName))
                    {
                        <span class="product-category-chip muted">@Model.SubCategoryName</span>
                    }
                </div>

                <h2 class="product-detail-title">@Model.Name</h2>

                <div class="product-rating-row">
                    <span class="product-rating-score">5.0</span>
                    <span class="product-rating-stars" aria-label="Product rating">
                        <i class="ion-ios-star"></i>
                        <i class="ion-ios-star"></i>
                        <i class="ion-ios-star"></i>
                        <i class="ion-ios-star"></i>
                        <i class="ion-ios-star-half"></i>
                    </span>
                    <span class="product-rating-note">100 ratings</span>
                    <span class="product-rating-note">500 sold</span>
                </div>

                <div id="attribute-container" class="variant-attributes product-detail-attributes"></div>

                <div class="product-purchase-card">
                    <div class="product-price-stock">
                        <div>
                            <span class="product-info-label">Price</span>
                            <strong id="dynamic-price" class="product-current-price">$@Model.Price</strong>
                        </div>
                        <div>
                            <span class="product-info-label">Stock</span>
                            <strong id="dynamic-stock" class="product-stock-text">@Model.Stock available</strong>
                        </div>
                    </div>

                    <div class="product-action-row">
                        <div class="product-detail-qty" aria-label="Quantity selector">
                            <button type="button" class="qty-minus" data-type="minus" aria-label="Decrease quantity">
                                <i class="fa-solid fa-minus"></i>
                            </button>
                            <input type="text" id="quantity" class="quantity input-number" value="1" min="1" max="100" inputmode="numeric" aria-label="Quantity">
                            <button type="button" class="qty-plus" data-type="plus" aria-label="Increase quantity">
                                <i class="fa-solid fa-plus"></i>
                            </button>
                        </div>

                        <div class="product-action-buttons">
                            <button type="button" class="btn btn-black product-add-btn" data-id="@Model.Id">
                                <i class="fa-solid fa-cart-plus"></i>
                                <span>Add to Cart</span>
                            </button>
                            <button type="button" class="btn btn-primary product-buy-btn" data-id="@Model.Id">
                                <i class="fa-solid fa-bag-shopping"></i>
                                <span>Buy now</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="product-detail-tabs">
            <div class="nav nav-pills product-detail-nav" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                <a class="nav-link active" id="v-pills-1-tab" data-toggle="pill" href="#v-pills-1" role="tab" aria-controls="v-pills-1" aria-selected="true">Description</a>
                <a class="nav-link" id="v-pills-3-tab" data-toggle="pill" href="#v-pills-3" role="tab" aria-controls="v-pills-3" aria-selected="false">Reviews</a>
            </div>

            <div class="tab-content product-detail-tab-content" id="v-pills-tabContent">
                <div class="tab-pane fade show active" id="v-pills-1" role="tabpanel" aria-labelledby="day-1-tab">
                    <h3>About this product</h3>
                    <p>@Model.Description</p>
                </div>

                <div class="tab-pane fade" id="v-pills-3" role="tabpanel" aria-labelledby="v-pills-day-3-tab">
                    <div class="product-empty-review">
                        <i class="fa-regular fa-message"></i>
                        <div>
                            <h3>Reviews are coming soon</h3>
                            <p>Customer reviews for this product will appear here when they are available.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    $(document).on('click', '.qty-plus', function (e) {
        e.preventDefault();

        let input = $(this)
            .closest('.product-detail-qty')
            .find('.quantity');

        let qty = parseInt(input.val()) || 1;

        input.val(qty + 1);
    });

    $(document).on('click', '.qty-minus', function (e) {
        e.preventDefault();

        let input = $(this)
            .closest('.product-detail-qty')
            .find('.quantity');

        let qty = parseInt(input.val()) || 1;

        if (qty > 1) input.val(qty - 1);
    });
</script>
