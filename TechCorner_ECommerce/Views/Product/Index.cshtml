@model X.PagedList.IPagedList<TechCorner_ECommerce.ViewModels.ProductVM>
@using X.PagedList.Mvc.Core;

@{
    ViewData["Title"] = "Products";
    Layout = "_LayoutProduct";
}

@section lib{
    

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <link rel="stylesheet" href="~/css/StyleProdPage.css" asp-append-version="true">
    <script src="~/js/addToCart.js"></script>
    <script src="~/js/variantManager.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

}

@section breadcrumbs {
<div class="hero-wrap hero-bread shop-hero" style="background-image: url('/images/bg_6.jpg')">
    <div class="container">
        <div class="row no-gutters slider-text align-items-end">
            <div class="col-md-9 pb-5 ftco-animate">
                <p class="breadcrumbs">
                    <span class="mr-2"><a asp-controller="Home" asp-action="Index">Home</a></span>
                    <span>Shop</span>
                </p>
                <h1 class="mb-0 bread">Shop</h1>
            </div>
        </div>
    </div>
</div>
}

<div class="shop-toolbar">
    @if (!string.IsNullOrWhiteSpace(ViewBag.SearchQuery as string))
    {
        <p>@Model.TotalItemCount sản phẩm cho "@ViewBag.SearchQuery"</p>
    }
    else
    {
        <p>@Model.TotalItemCount sản phẩm</p>
    }
</div>

@if (!Model.Any())
{
    <div class="shop-empty-state">
        <i class="fa-regular fa-face-smile"></i>
        <h3>No products found</h3>
        <p>Try another keyword or choose a different category.</p>
        <a asp-controller="Product" asp-action="Index" class="btn btn-black">View all products</a>
    </div>
}
else
{
    <div class="shop-product-grid">
        @foreach (var item in Model)
        {
            <article class="shop-product-card ftco-animate">
                <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Slug" class="shop-product-media">
                    <img src="@item.ImageUrl" alt="@item.Name">
                </a>

                <div class="shop-product-body">
                    <div class="shop-product-meta">
                        <span class="shop-category">@item.CategoryName</span>
                        <span class="shop-rating">
                            <i class="ion-ios-star"></i>
                            5.0
                        </span>
                    </div>

                    <h3>
                        <a asp-controller="Product" asp-action="Detail" asp-route-id="@item.Slug">@item.Name</a>
                    </h3>

                    <div class="shop-product-footer">
                        <strong>$@item.Price</strong>
                        <button type="button" class="shop-add-btn" onclick="PopupProduct.open(@item.Id)">
                            <i class="fa-solid fa-cart-plus"></i>
                            <span>Add</span>
                        </button>
                    </div>
                </div>
            </article>
        }
    </div>
}

@await Html.PartialAsync("_VariantPopup")

