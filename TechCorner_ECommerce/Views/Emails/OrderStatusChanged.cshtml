@model TechCorner_ECommerce.ViewModels.OrderStatusEmailVM

<div style="font-family:Arial,sans-serif;max-width:640px;margin:auto;color:#111827">
    <h2>Order status updated</h2>
    <p>Hi @Model.ReceiverName, your order <strong>@Model.OrderCode</strong> has been updated.</p>

    <table style="width:100%;border-collapse:collapse;margin-top:16px">
        <tr>
            <td style="padding:10px;border-bottom:1px solid #e5e7eb">Order status</td>
            <td style="padding:10px;border-bottom:1px solid #e5e7eb"><strong>@Model.OldStatus</strong> to <strong>@Model.NewStatus</strong></td>
        </tr>
        <tr>
            <td style="padding:10px;border-bottom:1px solid #e5e7eb">Payment status</td>
            <td style="padding:10px;border-bottom:1px solid #e5e7eb"><strong>@Model.OldPaymentStatus</strong> to <strong>@Model.NewPaymentStatus</strong></td>
        </tr>
    </table>

    <p style="color:#6b7280">Thank you for shopping with TechCorner.</p>
</div>
