@model IEnumerable<TechCorner_ECommerce.ViewModels.CartItemVM>
@{
	ViewData["Title"] = "Cart";
    var cartTotal = Model.Sum(p => p.SubTotal);
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet"/>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>  
<div class="hero-wrap hero-bread" style="background-image: url('images/bg_6.jpg');">
    <div class="container">
    <div class="row no-gutters slider-text align-items-center justify-content-center">
        <div class="col-md-9 ftco-animate text-center">
        <p class="breadcrumbs"><span class="mr-2"><a href="index.html">Home</a></span> <span>Cart</span></p>
        <h1 class="mb-0 bread">My Wishlist</h1>
        </div>
    </div>
    </div>
</div>
<section class="ftco-section ftco-cart">
    <div class="container" style="max-width: 1500px;">
        <div class="row cart-wrapper">

            <!--PRODUCT TABLE-->
            <div class="col-lg-9 ftco-animate d-flex">
                <div class="cart-list w-100">
                    <table class="table">
                        <thead class="thead-primary">
                            <tr class="text-center">
                                <th>&nbsp;</th>
                                <th>&nbsp;</th>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        @await Html.PartialAsync("_CartContent", Model)
                    </table>
                </div>
            </div>

            <!--CART TOTAL-->
            <div class="col-lg-3 cart-wrap ftco-animate">

                <div class="cart-total  w-100">
                    <h3>Cart Totals</h3>

                    <p class="d-flex">
                        <span>Subtotal</span>
                        <span id="cart-subtotal" data-value="@Model.Sum(p => p.SubTotal)">
                            $@Model.Sum(p => p.SubTotal)
                        </span>
                    </p>

                    <p class="d-flex">
                        <span>Delivery</span>
                        <span>0.00</span>
                    </p>


                    <hr>

                    <p class="d-flex total-price">
                        <span>Total</span>
                        <span id="cart-total">$@cartTotal</span>
                    </p>

                    <a asp-controller="Order" asp-action="Checkout" class="btn btn-primary py-1 px-2 mt-auto">
                        Proceed to Checkout
                    </a>
                </div>

                
            </div>

        </div>
    </div>
</section>



<script>
    document.addEventListener("click", function (e) {

        const cartQtyEl = document.getElementById("cart-qty");

        function postCartAction(url, data) {
            return fetch(url, {
                method: "POST",
                headers: {
                    "Content-Type": "application/x-www-form-urlencoded",
                    "RequestVerificationToken": getToken()
                },
                body: new URLSearchParams(data)
            }).then(res => res.json());
        }

        function updateSubtotal(data) {
            const total = data.totalPrice ?? data.subTotal;

            if (total == null) return;

            const value = "$" + Number(total).toLocaleString("en-US", {
                minimumFractionDigits: 0,
                maximumFractionDigits: 2
            });

            const subtotalEl = document.getElementById("cart-subtotal");
            const totalEl = document.getElementById("cart-total");

            if (subtotalEl) subtotalEl.innerText = value;
            if (totalEl) totalEl.innerText = value;
        }

        function updateCartQuantity(data) {
            if (cartQtyEl) {
                cartQtyEl.innerText = data.quantity;
            }
        }

        function showCartError(data, input, row) {
            toastr.error(data.message || "Cart could not be updated.");

            if (data.removed) {
                row?.remove();
            }

            if (input && data.available && Number(data.available) > 0) {
                input.value = data.available;
            }

            updateCartQuantity(data);
            updateSubtotal(data);
        }

        function updateCart(productId, qty, input, row) {

            postCartAction("/Cart/UpdateQuantity", { productId, quantity: qty })
                .then(data => {

                    if (!data.success) {
                        showCartError(data, input, row);
                        return;
                    }

                    if (input) {
                        input.value = qty;
                    }

                    if (row) {
                        const price = parseFloat(
                            row.querySelector(".price")?.innerText.replace(/[^\d.-]/g, "")
                        ) || 0;

                        const totalCell = row.querySelector(".total");

                        if (totalCell) {
                            totalCell.innerText = "$" + (price * qty).toLocaleString("en-US");
                        }
                    }

                    updateCartQuantity(data);

                    updateSubtotal(data);

                    toastr.success("Cart Updated!!");
                })
                .catch(() => toastr.error("Cart could not be updated."));
        }


        // REMOVE
        const removeBtn = e.target.closest(".js-remove-cart");

        if (removeBtn) {

            e.preventDefault();

            const productId = removeBtn.dataset.id;
            const row = removeBtn.closest("tr");

            postCartAction("/Cart/RemoveCart", { productId })
                .then(data => {

                    if (!data.success) {
                        showCartError(data, null, row);
                        return;
                    }

                    row?.remove();

                    updateCartQuantity(data);

                    updateSubtotal(data);

                    toastr.success("Item Deleted");
                })
                .catch(() => toastr.error("Item could not be deleted."));

            return;
        }


        // PLUS
        const plusBtn = e.target.closest(".qty-plus");

        if (plusBtn) {

            const productId = plusBtn.dataset.id;
            const wrapper = plusBtn.closest(".js-cart-qty");
            const input = wrapper?.querySelector("input");
            const row = plusBtn.closest("tr");

            const qty = parseInt(input?.value || "1") + 1;

            updateCart(productId, qty, input, row);

            return;
        }


        // MINUS
        const minusBtn = e.target.closest(".qty-minus");

        if (minusBtn) {

            const productId = minusBtn.dataset.id;
            const row = minusBtn.closest("tr");
            const input = row?.querySelector("input");

            const qty = parseInt(input?.value || "1");

            if (qty <= 1) {

                postCartAction("/Cart/RemoveCart", { productId })
                    .then(data => {

                        if (!data.success) {
                            showCartError(data, input, row);
                            return;
                        }

                        row?.remove();

                        updateCartQuantity(data);

                        updateSubtotal(data);

                        toastr.success("Item Deleted");
                    })
                    .catch(() => toastr.error("Item could not be deleted."));

                return;
            }

            updateCart(productId, qty - 1, input, row);
        }

    });



// ================= TOAST CONFIG =================
toastr.options = {
    closeButton: true,
    progressBar: true,
    positionClass: "toast-top-right",
    timeOut: "300"
};
</script>






